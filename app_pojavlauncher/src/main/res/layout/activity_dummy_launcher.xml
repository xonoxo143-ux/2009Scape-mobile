<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#231c09">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2009Scape"
        android:textColor="#E2C887"
        android:textStyle="bold"
        android:textSize="28sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Single Player"
        android:textColor="#B8A078"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/serverStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Server: stopped"
        android:textColor="#D8D0B0"
        android:textSize="13sp" />

    <Button
        android:id="@+id/playSinglePlayer"
        android:layout_width="320dp"
        android:layout_height="72dp"
        android:layout_marginTop="18dp"
        android:text="PLAY"
        android:textAllCaps="true"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/worldSettings"
            android:layout_width="170dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:text="World Settings"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/playerSettings"
            android:layout_width="170dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="Player Settings"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/serverFiles"
            android:layout_width="170dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:text="Server Files"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/updateFromGitHub"
            android:layout_width="170dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="Update Game"
            android:textAllCaps="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/updateStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:maxLines="2"
        android:text=""
        android:textColor="#B8A078"
        android:textSize="12sp" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Advanced launcher settings"
        android:textColor="#B8A078"
        android:textSize="12sp" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="42dp" />

</LinearLayout>
