<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#231c09">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2009Scape"
            android:textColor="#E2C887"
            android:textStyle="bold"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Single Player"
            android:textColor="#B8A078"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/serverStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Preparing local game..."
            android:textColor="#D8D0B0"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/updateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:minHeight="20dp"
            android:maxLines="2"
            android:text=""
            android:textColor="#B8A078"
            android:textSize="11sp" />

        <Button
            android:id="@+id/playSinglePlayer"
            android:layout_width="320dp"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="PLAY"
            android:textAllCaps="true"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/settings"
                android:layout_width="165dp"
                android:layout_height="46dp"
                android:layout_marginEnd="5dp"
                android:text="Settings"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/updateFromGitHub"
                android:layout_width="185dp"
                android:layout_height="46dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:text="Update from GitHub"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/serverFiles"
                android:layout_width="165dp"
                android:layout_height="46dp"
                android:layout_marginStart="5dp"
                android:text="World Files"
                android:textAllCaps="false" />
        </LinearLayout>

        <com.kdt.mcgui.ProgressLayout
            android:id="@+id/progress_layout"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>
